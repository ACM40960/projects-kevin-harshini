# .env

# Anthropic — get at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# FRED macro data — get free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_key_here

# Qdrant — we run locally in Phase 1, so this is just a placeholder
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=quantrag_phase1