# Cell 4 -- Load chunks and inspect
import json

records = []
with open(chunks_path, 'r', encoding='utf-8') as f:
    for line in f:
        line = line.strip()
        if line:
            records.append(json.loads(line))

print(f'Total chunks loaded: {len(records):,}')
print(f'Sample record keys: {list(records[0].keys())}')
print(f'Sample citation: {records[0]["citation"]}')

# Cell 5 -- Load BGE-large on GPU
from sentence_transformers import SentenceTransformer

model = SentenceTransformer('BAAI/bge-large-en-v1.5', device='cuda')
print('Model loaded on GPU (dim=1024)')

# Cell 6 -- Embed all chunks in shards
# Writes a new .parquet file every SHARD_SIZE chunks so:
#   - memory stays bounded even for 300K+ chunks
#   - if Colab disconnects, you keep whatever shards finished
#   - each shard downloads as a manageable file

import pandas as pd
import numpy as np
import os
import time
from tqdm.auto import tqdm

SHARD_SIZE  = 20000     # chunks per output file
BATCH_SIZE  = 128       # GPU can handle much larger batches than CPU/MPS
OUTPUT_DIR  = 'embeddings_output'
os.makedirs(OUTPUT_DIR, exist_ok=True)

PREFIX = 'Represent this financial document for retrieval: '

shard_num = 0
start_time = time.time()

for shard_start in range(0, len(records), SHARD_SIZE):
    shard_records = records[shard_start: shard_start + SHARD_SIZE]
    texts = [PREFIX + r['text'] for r in shard_records]

    print(f'\nShard {shard_num}: embedding {len(texts):,} chunks...')

    vectors = model.encode(
        texts,
        batch_size=BATCH_SIZE,
        normalize_embeddings=True,
        show_progress_bar=True,
        convert_to_numpy=True,
    )

    df = pd.DataFrame({
        'id':           [r['id'] for r in shard_records],
        'vector':       [v.tolist() for v in vectors],
        'text':         [r['text'] for r in shard_records],
        'ticker':       [r['ticker'] for r in shard_records],
        'company_name': [r['company_name'] for r in shard_records],
        'year':         [r['year'] for r in shard_records],
        'section':      [r['section'] for r in shard_records],
        'chunk_index':  [r['chunk_index'] for r in shard_records],
        'total_chunks': [r['total_chunks'] for r in shard_records],
        'filing_date':  [r['filing_date'] for r in shard_records],
        'citation':     [r['citation'] for r in shard_records],
    })

    out_path = os.path.join(OUTPUT_DIR, f'embeddings_part_{shard_num:04d}.parquet')
    df.to_parquet(out_path, index=False)

    elapsed = time.time() - start_time
    print(f'  Saved {out_path}  ({len(df)} rows, {elapsed:.0f}s elapsed total)')

    shard_num += 1

print(f'\nDone. {shard_num} shard files written to {OUTPUT_DIR}/')

